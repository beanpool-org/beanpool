{
  "name": "beanpool-monorepo",
  "version": "1.2.27",
  "private": true,
  "scripts": {
    "build": "dotenv -- turbo run build",
    "dev": "dotenv -- turbo run dev",
    "manager": "pnpm --filter @beanpool/manager dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test-all": "bash scripts/test-all.sh",
    "guide:publish": "node packages/beanpool-guide/scripts/publish.mjs",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.4.0",
    "turbo": "^2.8.17",
    "typescript-eslint": "^8.59.4",
    "vitest": "^3.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "workerd"
    ],
    "overrides": {
      "esbuild": "0.25.12",
      "react-native-worklets": "0.7.4",
      "expo-image-loader": "55.0.1"
    },
    "patchedDependencies": {
      "is-generator-function@1.1.2": "patches/is-generator-function@1.1.2.patch",
      "react-native-map-clustering@4.0.0": "patches/react-native-map-clustering@4.0.0.patch",
      "expo-screen-capture@55.0.18": "patches/expo-screen-capture@55.0.18.patch",
      "expo-web-browser@55.0.20": "patches/expo-web-browser@55.0.20.patch"
    }
  },
  "packageManager": "pnpm@9.0.0"
}
