#!/bin/zsh
# Fake gh for selftest.sh — never talks to GitHub. Every call is appended to $FAKE_STATE/gh.calls.
#   FAKE_GH_DOWN=1            every `gh api` call fails (GitHub not answering)
#   FAKE_GH_COMMENTS_DOWN=1   only the PR comments call fails
#   FAKE_GH_RUNS_DOWN=1       only `gh run list --commit` fails
#   FAKE_GH_PR=N     what `gh pr list --head` returns (empty = no PR)
#   $FAKE_STATE/comments   the PR's inline comment count
#   $FAKE_STATE/head       the PR's head commit (no file: fakehead; empty: GitHub does not say)
#   $FAKE_STATE/pushes     heads still to come, one per line: a push moves the PR to the next (fake agy/claude push in a CI fix stage)
#   $FAKE_STATE/ci-<sha>   that commit's required check, one line per read, the last one sticks: success failure cancelled pending,
#                          none (GitHub has not created the check), or any of those +push (a push lands during that read). No file: success.
#   $FAKE_STATE/run-<sha>  that commit's workflow run, one line per read, the last one sticks: queued in_progress success failure cancelled. No file: no run.
#   $FAKE_STATE/files      the PR's changed files, one per line (no file: src/a.ts)
# --jq filters run through real jq over GitHub's JSON shape (gh's own is gojq), so the library's filters are what gets tested.
S=${FAKE_STATE:?}
print -r -- "gh $*" >> "$S/gh.calls"
args=("$@"); jqf=
for (( i = 1; i < $#args; i++ )); do [ "$args[i]" = --jq ] && jqf=$args[i+1]; done
pop(){ # FILE DEFAULT → FILE's first line; the line goes unless it is the last
  [ -s "$1" ] || { print -r -- "$2"; return; }
  sed -n 1p "$1"
  [ "$(wc -l < "$1")" -gt 1 ] && sed -i '' 1d "$1"
  return 0; }
push(){ [ -s "$S/pushes" ] && { sed -n 1p "$S/pushes" > "$S/head"; sed -i '' 1d "$S/pushes"; }; }
case "$1 $2" in
  api\ *)     [ "$FAKE_GH_DOWN" = 1 ] && { print -u2 "HTTP 502: Bad Gateway"; exit 1; }
              case "$2" in
                */check-runs*check_name=*)
                  # A wait with no limit fails its scenario here instead of hanging the self-test.
                  [ "$(grep -c 'check_name=' "$S/gh.calls")" -gt 100 ] && { print -u2 "fake gh: runaway polling"; exit 1; }
                  sha=${${2#*/commits/}%%/*}; st=$(pop "$S/ci-$sha" success)
                  [ -d "$LANE_LOCK_DIR/decide.lock" ] && print -r -- "$sha" >> "$S/ci-read-in-the-slot"
                  [[ "$st" == *+push ]] && { st=${st%+push}; push; }
                  case "$st" in
                    none)    print -r -- '{"check_runs":[]}';;
                    pending) print -r -- '{"check_runs":[{"conclusion":null}]}';;
                    *)       print -r -- "{\"check_runs\":[{\"conclusion\":\"$st\"}]}";;
                  esac | jq -r "$jqf";;
                */check-runs*)
                  print -r -- '{"check_runs":[
                    {"name":"Test-All shard checks","conclusion":"success","html_url":"https://github.com/example/fake/actions/runs/7/job/30"},
                    {"name":"Test-All shard server-3","conclusion":"failure","html_url":"https://github.com/example/fake/actions/runs/7/job/31"},
                    {"name":"Test-All shard vitest-pwa-1","conclusion":"timed_out","html_url":"https://github.com/example/fake/actions/runs/7/job/32"},
                    {"name":"Test-All shard server-1","conclusion":null,"html_url":"https://github.com/example/fake/actions/runs/7/job/33"},
                    {"id":41,"name":"Cloudflare Pages","conclusion":"failure","html_url":"https://github.com/example/fake/runs/41"},
                    {"id":42,"name":"Some other app","conclusion":"failure","html_url":null}]}' | jq -r "$jqf";;
                */pulls/*/files*)
                  { [ -s "$S/files" ] && cat "$S/files" || print src/a.ts; } | jq -Rs 'split("\n") | map(select(length > 0) | {filename: .})' | jq -r "$jqf";;
                *)
                  [ "$FAKE_GH_COMMENTS_DOWN" = 1 ] && { print -u2 "HTTP 502: Bad Gateway"; exit 1; }
                  cat "$S/comments" 2>/dev/null || print 0;;
              esac;;
  "pr list")  print -r -- "$FAKE_GH_PR";;
  "pr view")  case "$*" in
                *headRefOid*) cat "$S/head" 2>/dev/null || print fakehead;;
                *isDraft*) print false;; *state*) print OPEN;; *headRefName*) print feat/x;;
                *mergeable*) print MERGEABLE;; *title*) print "Fake title";;
              esac;;
  "pr ready") ;;
  "pr merge") print -r -- "$*" >> "$S/merges";;
  "run list") if [[ "$*" == *--commit* ]]; then
                [ "$FAKE_GH_RUNS_DOWN" = 1 ] && { print -u2 "HTTP 502: Bad Gateway"; exit 1; }
                sha=${args[$args[(i)--commit]+1]}; r=$(pop "$S/run-$sha" '')
                case "$r" in
                  '')                 print -r -- '[]';;
                  queued|in_progress) print -r -- "[{\"status\":\"$r\",\"conclusion\":\"\"}]";;
                  *)                  print -r -- "[{\"status\":\"completed\",\"conclusion\":\"$r\"}]";;
                esac | jq -r "$jqf"
              else print -r -- "${FAKE_GH_RUN:-completed success}"; fi;;
  *) print -u2 "fake gh: unhandled: $*"; exit 1;;
esac
