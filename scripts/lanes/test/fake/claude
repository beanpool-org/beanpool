#!/bin/zsh
# Fake headless Claude for selftest.sh — never talks to a model. FAKE_CLAUDE_MODE picks the behaviour; every call is
# appended to $FAKE_STATE/claude.calls.
S=${FAKE_STATE:?}
prompt= model= wt=none perm= fmt= verbose=no
while (( $# )); do
  case "$1" in
    -p) prompt=$2; shift;; --model) model=$2; shift;; --worktree) wt=$2; shift;;
    --permission-mode) perm=$2; shift;; --output-format) fmt=$2; shift;; --verbose) verbose=yes;;
  esac; shift
done
if [[ "$prompt" == *PROBE-OK* ]]; then
  n=$(( $(cat "$S/claude.probes" 2>/dev/null || print 0) + 1 )); print $n > "$S/claude.probes"
  print -r -- "probe $n model=$model" >> "$S/claude.calls"
  if (( n > ${FAKE_CLAUDE_PROBE_FAILS:-0} )); then print PROBE-OK; else print -u2 "API Error: 429 rate limit"; exit 1; fi
  exit 0
fi
n=$(( $(cat "$S/claude.runs" 2>/dev/null || print 0) + 1 )); print $n > "$S/claude.runs"
rules=no; [[ "$prompt" == *"RULES FOR THIS HEADLESS RUN"* ]] && rules=yes
print -r -- "run $n model=$model worktree=$wt perm=$perm format=$fmt verbose=$verbose cwd=$PWD rules=$rules" >> "$S/claude.calls"
if [ "$wt" != none ]; then mkdir -p ".claude/worktrees/$wt" && cd ".claude/worktrees/$wt"; fi
print -r -- "{\"type\":\"system\",\"subtype\":\"init\",\"cwd\":\"$PWD\"}"
result(){ print -r -- "{\"type\":\"result\",\"subtype\":\"$1\",\"is_error\":$2,\"result\":\"$3\"}"; }
case "${FAKE_CLAUDE_MODE:-success}" in
  success)
    [[ "$prompt" == *"Review pull request"* ]] && [ -n "$FAKE_REVIEW_POSTS" ] \
      && print $(( $(cat "$S/comments" 2>/dev/null || print 0) + FAKE_REVIEW_POSTS )) > "$S/comments"
    sleep 1; result success false "All done; PR open.";;
  promise)
    # What the first real headless build did: background the full suite, promise a report, stop replying.
    sleep 600 </dev/null >/dev/null 2>&1 &!
    print $! > "$S/claude.orphan"
    sleep 3
    result success false "PR is open. The full suite is still running; I will report when it finishes.";;
  quota_once)
    if (( n == 1 )); then result error_during_execution true "Claude AI usage limit reached"; exit 1; fi
    sleep 1; result success false "All done.";;
  fail_fable)
    if [ "$model" = claude-fable-5-1 ]; then print -u2 "API Error: 500 internal"; exit 1; fi
    sleep 1; result success false "No new defects.";;
  *) print -u2 "fake claude: unknown mode $FAKE_CLAUDE_MODE"; exit 2;;
esac
