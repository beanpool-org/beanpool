# Cloudflare Pages response headers.
#
# The members' guide JSON is fetched by the web app, which each community serves from its own address, so the
# browser needs permission to read it across sites. It is public, read-only text; the apps check it before use.
/guide/guide.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=600

# One rule per path: Cloudflare joins every rule that matches, and a doubled "*, *" is refused by browsers.
/guide/*/guide.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=600

# Block indexing and caching for translation sources
/content/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store


