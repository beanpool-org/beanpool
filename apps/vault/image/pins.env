# Everything the vault's image is built from, pinned (key vault design §3; host design §5.1 item 5). Two builds from
# the same commit, these pins and the same custodian keys give the same bytes. Change any line and the image hash
# changes: that is a new release, signed by two custodians and installed at a monthly restart.

# Debian stable (13, trixie) exactly as it was at this moment, security updates included: snapshot.debian.org.
DEBIAN_SNAPSHOT=20260915T000000Z
# File times in the image are clamped to the snapshot's (2026-09-15T00:00:00Z).
SOURCE_DATE_EPOCH=1789430400
# The build environment: this Debian image (by digest), with its tools (mkosi, systemd-repart, ukify, mkfs.erofs)
# installed from the same snapshot.
BUILDER_BASE=debian:trixie-slim@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a
# The vault's Node (the official build, not Debian's: the vault never uses Debian's Node or its OpenSSL).
# From https://nodejs.org/dist/v24.21.0/SHASUMS256.txt.
NODE_VERSION=24.21.0
NODE_SHA256=fd8e59d5a511510f6a298afb548f18c7d2b1be404d8b4a27d94fbe49f56cb2d6
# systemd-repart's seed: partition and file system UUIDs come from it (uuid5 of this directory's URL).
IMAGE_SEED=563c23f1-6309-5c8f-a75e-1ed628f9ba99
