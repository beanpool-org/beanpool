{
  "sections": {
    "about": {
      "title": {
        "text": "關於 BeanPool",
        "sourceHash": "2d9dd281fa519636"
      },
      "summary": {
        "text": "BeanPool 的運作方式、規則與決策機制、常見問題以及最新動態。",
        "sourceHash": "003302493f5fd51a"
      }
    },
    "getting-started": {
      "title": {
        "text": "開始使用",
        "sourceHash": "831d0f72d242b7d1"
      },
      "summary": {
        "text": "首頁、加入方式、尋找附近的社群、豆子與全球社群及其限制、你的 12 個助記詞、個人檔案、頂端列、本指南、取得協助、使用多個社群以及網頁版應用程式。",
        "sourceHash": "63d6211469096565"
      }
    },
    "market": {
      "title": {
        "text": "市集",
        "sourceHash": "5238d9bd03d543e6"
      },
      "summary": {
        "text": "尋找和發布「提供」與「需求」，以及一筆交易從開始到完成的完整流程。",
        "sourceHash": "6008ab9bf397a83a"
      }
    },
    "map": {
      "title": {
        "text": "地圖",
        "sourceHash": "be176b0015c424b7"
      },
      "summary": {
        "text": "圖釘的含義、你的圖釘位置，以及尋找附近的物品與服務。",
        "sourceHash": "b4e17982e037f558"
      }
    },
    "talk": {
      "title": {
        "text": "聊天",
        "sourceHash": "449f5a775762cdc5"
      },
      "summary": {
        "text": "訊息、群組及其聊天室、人脈與好友、活動聊天室、靜音、提及以及金鑰變更。",
        "sourceHash": "e680a96492c72e47"
      }
    },
    "pulse": {
      "title": {
        "text": "動態",
        "sourceHash": "f7a403c6cdf31e72"
      },
      "summary": {
        "text": "鄰居分享的內容、「學習」影片以及新增你自己的頻道。",
        "sourceHash": "9ab06ad52ef86462"
      }
    },
    "commons": {
      "title": {
        "text": "公共板塊",
        "sourceHash": "6aa9f1a43424d37b"
      },
      "summary": {
        "text": "決策與投票、共享豆子、群組、事業與管理人。投票與活動也在其中；你也可以在市集中找到它們。",
        "sourceHash": "bd9454f4374e35ae"
      }
    },
    "ledger": {
      "title": {
        "text": "帳本",
        "sourceHash": "ee69eb4afc76aae0"
      },
      "summary": {
        "text": "你的餘額、信用額度、贈送、信任徽章、每位交易夥伴的限額以及流通費。",
        "sourceHash": "99d7457bf048947c"
      }
    },
    "settings": {
      "title": {
        "text": "設定與安全",
        "sourceHash": "8ee717d56a807cd5"
      },
      "summary": {
        "text": "隱私與管理員及其 AI 助手可見內容、所在地區、封鎖與檢舉、提醒、淺色與深色模式、外出時的休假模式、離開、找回帳號以及所有者檢查 12 個助記詞。",
        "sourceHash": "767b3834909fa76c"
      }
    }
  },
  "pages": {
    "how-it-works": {
      "title": {
        "text": "BeanPool 運作方式",
        "sourceHash": "8ee2145ba2a47e77"
      },
      "summary": {
        "text": "用通俗的話解釋豆子、交易、提供與需求以及信用。",
        "sourceHash": "921252df227ae544"
      }
    },
    "rules": {
      "title": {
        "text": "規則與決策機制",
        "sourceHash": "482819c153332e58"
      },
      "summary": {
        "text": "投票、投票率、無記名投票、投票資格、暫停資格、移除成員、管理人以及召集人和主召集人。",
        "sourceHash": "b111b31338cdd2a3"
      }
    },
    "faq": {
      "title": {
        "text": "常見問題",
        "sourceHash": "9a72221a27476f3e"
      },
      "summary": {
        "text": "成員最常提出問題的簡要解答。",
        "sourceHash": "8feb7069cb08f93d"
      }
    },
    "whats-new": {
      "title": {
        "text": "最新動態",
        "sourceHash": "135e912e89054ffa"
      },
      "summary": {
        "text": "用平易近人的文字介紹應用程式的最新變化。",
        "sourceHash": "e1f96938296c5950"
      }
    },
    "home": {
      "title": {
        "text": "首頁",
        "sourceHash": "3a78695388b38b5c"
      },
      "summary": {
        "text": "首頁是什麼、在手機與網頁版上顯示的卡片、如何新增、移動或移除卡片、選擇興趣偏好以及登出時的隱私保護。",
        "sourceHash": "a1c1ff42cd312dd2"
      },
      "help": {
        "text": "這是你的首頁：展示需要你關注的事項及附近動態的卡片。在底部新增卡片，或點擊卡片上的 … 進行移動或移除。",
        "sourceHash": "3842000d41b06fa3"
      }
    },
    "joining": {
      "title": {
        "text": "加入 BeanPool",
        "sourceHash": "4a4fa8d50d056023"
      },
      "summary": {
        "text": "兩種加入方式：憑成員邀請加入在地社群，或在開放時憑 12 個助記詞或一次登入加入全球社群。申請加入社群以及如何邀請他人。",
        "sourceHash": "bfa09f20fea858c6"
      },
      "help": {
        "text": "憑成員邀請加入在地社群，或在開放時憑 12 個助記詞或一次登入加入全球社群。",
        "sourceHash": "288300534966c3d2"
      }
    },
    "finding-a-community": {
      "title": {
        "text": "尋找附近的社群",
        "sourceHash": "dbb0b4170f999d18"
      },
      "summary": {
        "text": "從全球社群出發，尋找附近的社群並申請加入，在附近有新社群成立時獲得通知，或者自己發起一個社群。",
        "sourceHash": "d7fada0c8e749ecf"
      }
    },
    "beans-and-the-global-community": {
      "title": {
        "text": "豆子與全球社群",
        "sourceHash": "e44e1649e26e9122"
      },
      "summary": {
        "text": "全球社群的用途、眾多社群中的一員，以及你在那裡看到的內容：🏘️ 在地社區標記、範例社群 Example Valley、為什麼豆子在那裡等待，以及如何發起或尋找在地社群。",
        "sourceHash": "f91dcd042d53fdfb"
      }
    },
    "global-community-limits": {
      "title": {
        "text": "全球社群的限制",
        "sourceHash": "79186984a4ee4919"
      },
      "summary": {
        "text": "全球社群免費開放，並透過少許限制來維持低成本。內容在最後修改 90 天後封存。每則貼文最多 5 張相片，手機保留最近的 500 則刊登，你可以追蹤 3 個地點。",
        "sourceHash": "feba3e6c852b6d3b"
      }
    },
    "your-12-words": {
      "title": {
        "text": "你的 12 個助記詞",
        "sourceHash": "dd2264b1e132960b"
      },
      "summary": {
        "text": "這 12 個助記词是你帳號的金鑰。它們為何重要、在哪裡找到、如何安全保存，以及新增登入方式作為備用復原途徑。",
        "sourceHash": "7033308ae096c586"
      }
    },
    "your-profile": {
      "title": {
        "text": "個人檔案",
        "sourceHash": "528d89ad72cba22e"
      },
      "summary": {
        "text": "你的暱稱、相片、個人簡述以及誰可以查看你的聯絡方式。",
        "sourceHash": "f405b4421669fcdb"
      }
    },
    "the-top-bar": {
      "title": {
        "text": "頂端列",
        "sourceHash": "67f6e62947dde848"
      },
      "summary": {
        "text": "豆子圖示、有待處理事項時顯示的小圖示，以及右上角的按鈕。",
        "sourceHash": "19dc6a309244ae90"
      }
    },
    "the-bean": {
      "title": {
        "text": "本指南",
        "sourceHash": "1d8917503dda7b5f"
      },
      "summary": {
        "text": "在哪裡找到本指南、如何搜尋內容以及指南如何保持最新。",
        "sourceHash": "7e694a121aa2314d"
      }
    },
    "getting-help": {
      "title": {
        "text": "取得協助",
        "sourceHash": "418313b75b185ab8"
      },
      "summary": {
        "text": "遇到問題時在哪裡尋找答案，以及向誰求助。",
        "sourceHash": "8d12d16dc2217232"
      }
    },
    "communities": {
      "title": {
        "text": "加入多個社群",
        "sourceHash": "b753dd3e548b2230"
      },
      "summary": {
        "text": "用一個帳號加入多個社群、在它們之間切換、跟隨你的社群遷移到新位址，以及查看全球社群向你展示的內容。",
        "sourceHash": "71e99c6bbffadcbe"
      }
    },
    "web-app": {
      "title": {
        "text": "在網頁瀏覽器中使用 BeanPool",
        "sourceHash": "1daaa01a91ba4b17"
      },
      "summary": {
        "text": "網頁版擁有手機版的大部分功能。在瀏覽器中加入全球社群、透過登入找回帳號、在手機上同步相同帳號，以及網頁版按鈕名稱的不同之處。",
        "sourceHash": "8afd3ad2f9117fd5"
      }
    },
    "browsing-the-market": {
      "title": {
        "text": "瀏覽市集",
        "sourceHash": "ab1b6bf5f734c023"
      },
      "summary": {
        "text": "透過搜尋、分類篩選和距離範圍尋找提供與需求。",
        "sourceHash": "e73e882abbebfa8d"
      },
      "help": {
        "text": "來自附近鄰居的提供與需求。按類別或距離搜尋篩選，或點擊「發布刊登」發布你自己的貼文。",
        "sourceHash": "0bc8b01c4d9effb6"
      }
    },
    "posting": {
      "title": {
        "text": "發布提供或需求",
        "sourceHash": "e218de31c1bbad00"
      },
      "summary": {
        "text": "發布你能做或能給予的事情，或者你正在尋找的東西。",
        "sourceHash": "9ffa9b1e66834bc0"
      }
    },
    "my-deals": {
      "title": {
        "text": "我的交易",
        "sourceHash": "bfad6bb30e1876c5"
      },
      "summary": {
        "text": "集中管理你參與的每一筆交易、發布的每一則刊登以及過去的交易紀錄。",
        "sourceHash": "8772e2ee242712d3"
      },
      "help": {
        "text": "你參與的每筆交易和發布的每則貼文。等待你回應的交易排在最上方。",
        "sourceHash": "3ec4be8c87368ed9"
      }
    },
    "a-deal-step-by-step": {
      "title": {
        "text": "交易步驟詳解",
        "sourceHash": "d2b29952cde1ab00"
      },
      "summary": {
        "text": "從發起詢問到完成付款，針對提供與需求的流程，以及留下評價。",
        "sourceHash": "88d4362d08a13bc5"
      }
    },
    "when-a-deal-goes-wrong": {
      "title": {
        "text": "交易出現問題時",
        "sourceHash": "190bfad1746f9e84"
      },
      "summary": {
        "text": "取消交易，以及雙方無法達成共識時該如何處理。",
        "sourceHash": "a68c0d7af60988b4"
      }
    },
    "map-pins": {
      "title": {
        "text": "地圖圖釘說明",
        "sourceHash": "dbd1bae516674246"
      },
      "summary": {
        "text": "地圖上的圖釘、顏色代表的含義以及圖釘周邊的操作按鈕。",
        "sourceHash": "79dec90cc1871495"
      },
      "help": {
        "text": "你附近的動態：綠色圖釘代表提供，橙色代表需求，紫色代表活動。點擊圖釘查看詳情。",
        "sourceHash": "0dae9edef568b7cd"
      }
    },
    "pin-locations": {
      "title": {
        "text": "你的圖釘位置",
        "sourceHash": "271264e11ffa7eaf"
      },
      "summary": {
        "text": "誰能看到你的刊登和活動所在位置，以及如何保護住家地址隱私。",
        "sourceHash": "a6ef3083e3ca4bfc"
      }
    },
    "near-you": {
      "title": {
        "text": "尋找附近的刊登",
        "sourceHash": "21bac241e8aef2ca"
      },
      "summary": {
        "text": "僅顯示距離你或你選擇的任意地點一定範圍內的貼文。",
        "sourceHash": "5158de7099e0e89b"
      }
    },
    "messages": {
      "title": {
        "text": "訊息",
        "sourceHash": "04d7b48339271ea6"
      },
      "summary": {
        "text": "發起聊天、傳送相片、回覆、表情回應、編輯、刪除、靜音以及隱私說明。",
        "sourceHash": "d97a6ef5d498fdde"
      },
      "help": {
        "text": "你的聊天室列表。一對一聊天受端對端加密保護。點擊聊天室以打開，或從貼文與好友列表中發起。",
        "sourceHash": "bb7067d935067660"
      }
    },
    "groups": {
      "title": {
        "text": "群組",
        "sourceHash": "39bbb719fa2b9d22"
      },
      "summary": {
        "text": "你的群組及群聊、在其中交流、建立群組、邀請成員、憑邀請加入以及群組內部投票。",
        "sourceHash": "4fa880d88c4b646f"
      },
      "help": {
        "text": "你的群組與群聊。建立群組、邀請他人，或開啟群組一起交流與投票。",
        "sourceHash": "ae3496f349eba2b3"
      }
    },
    "people": {
      "title": {
        "text": "成員與好友",
        "sourceHash": "99d59d29a0f3c756"
      },
      "summary": {
        "text": "尋找社群成員、新增好友以及為他人背書擔保。",
        "sourceHash": "4be4971d826d83fe"
      },
      "help": {
        "text": "社群成員與你的好友。點擊某人查看其個人檔案，或點擊好友旁的 💬 傳送訊息。",
        "sourceHash": "d90b46866bc2bb6f"
      }
    },
    "event-chat": {
      "title": {
        "text": "活動聊天",
        "sourceHash": "9c298662a4d6fc3e"
      },
      "summary": {
        "text": "與活動主辦人及所有參與者交流。",
        "sourceHash": "ae8ca7988e16e019"
      }
    },
    "mute": {
      "title": {
        "text": "靜音聊天室",
        "sourceHash": "8a491f4109c925c7"
      },
      "summary": {
        "text": "將個人、群組或事業的對話靜音 8 小時、一週或永久靜音。",
        "sourceHash": "ce143abea39ce423"
      }
    },
    "mentions": {
      "title": {
        "text": "提及 (@成員)",
        "sourceHash": "2e133ecc601b188f"
      },
      "summary": {
        "text": "在群聊中輸入 @ 加上成員姓名即可向其傳送提醒。",
        "sourceHash": "265d8fd594c5af23"
      }
    },
    "key-changed": {
      "title": {
        "text": "若對話提示對方金鑰已變更",
        "sourceHash": "79c7dc48aa148094"
      },
      "summary": {
        "text": "對話停止傳送的原因、如何與對方核對安全金鑰代碼，以及何時可以繼續交流。",
        "sourceHash": "c7a3e58ca019f963"
      }
    },
    "the-pulse": {
      "title": {
        "text": "社群動態",
        "sourceHash": "a974f2e05f105a24"
      },
      "summary": {
        "text": "鄰居在外部平台創作和分享的內容，彙整於一條動態消息中。",
        "sourceHash": "999659aebbfe69d2"
      },
      "help": {
        "text": "鄰居在其他平台製作或分享的連結彙整。點擊即可開啟。",
        "sourceHash": "1d19387da6116082"
      }
    },
    "learn": {
      "title": {
        "text": "「學習」專區",
        "sourceHash": "498e66e5947ca0c3"
      },
      "summary": {
        "text": "關於 BeanPool 的短片以及對應的指南頁面。",
        "sourceHash": "4d2fdf4c850fe47f"
      }
    },
    "your-channels": {
      "title": {
        "text": "分享你的頻道",
        "sourceHash": "e47ac70a91b21162"
      },
      "summary": {
        "text": "將你的 YouTube、部落格、Instagram 等頻道展示在動態中。",
        "sourceHash": "bc9819c938b91f04"
      }
    },
    "decisions": {
      "title": {
        "text": "參與決策投票",
        "sourceHash": "67b17269f83d1030"
      },
      "summary": {
        "text": "尋找進行中的決策、投票、更改你的投票並查看投票結果。",
        "sourceHash": "fc4b9c95d8478a91"
      }
    },
    "proposing-a-decision": {
      "title": {
        "text": "發起決策提案",
        "sourceHash": "3a20703895de04dc"
      },
      "summary": {
        "text": "提請社群共同做出具約束力的決定。",
        "sourceHash": "69756653393ec8b4"
      }
    },
    "polls": {
      "title": {
        "text": "投票",
        "sourceHash": "996729458535904a"
      },
      "summary": {
        "text": "向社群提出簡短問題。民意投票僅反映大家的看法，其本身不產生任何變更。",
        "sourceHash": "d7fadda691d8879b"
      },
      "help": {
        "text": "民意投票向社群快速徵詢意見。它展示大家的想法，但本身不產生任何變更。",
        "sourceHash": "99dfd4781ce0785d"
      }
    },
    "events": {
      "title": {
        "text": "活動",
        "sourceHash": "8d14f6e72de8f18a"
      },
      "summary": {
        "text": "在實體或線上發起一次性或週期性活動；報名參加、接收提醒、分享活動並作為主辦方進行管理。",
        "sourceHash": "29e8adc52f9b6df9"
      }
    },
    "enterprises": {
      "title": {
        "text": "專案與事業",
        "sourceHash": "e1ccbac49d2ba550"
      },
      "summary": {
        "text": "擁有獨立豆子帳目的共同事業：尋找、支持或自己發起一個專案或事業。",
        "sourceHash": "8302886bb796749e"
      }
    },
    "keepers": {
      "title": {
        "text": "管理人",
        "sourceHash": "ffc8948f6b16666e"
      },
      "summary": {
        "text": "共同經營並擔當事業責任的人。如何加入、提出異議以及退出。",
        "sourceHash": "cbe734a215f75289"
      }
    },
    "commons-fund": {
      "title": {
        "text": "公共資金",
        "sourceHash": "b1b09e953a4dd7c0"
      },
      "summary": {
        "text": "你所在社群的共享豆子：它們從何而來，以及如何支出運用。",
        "sourceHash": "aaf9158560e5d6aa"
      }
    },
    "your-balance": {
      "title": {
        "text": "餘額與帳目歷史",
        "sourceHash": "fb3a96eb2bfcd2a8"
      },
      "summary": {
        "text": "你擁有的豆子數量、交易中暫扣的豆子，以及每一筆交易與贈送紀錄。",
        "sourceHash": "61df521108b36035"
      },
      "help": {
        "text": "你的豆子：目前擁有的、交易暫扣的，以及所有交易和贈送紀錄。每個人都從零開始。",
        "sourceHash": "a40a5f9fef426c85"
      }
    },
    "credit-line": {
      "title": {
        "text": "信用額度",
        "sourceHash": "dd11b44ecc1037c9"
      },
      "summary": {
        "text": "你的餘額最多可以透支多少，以及額度如何增長。",
        "sourceHash": "18b609abc63667e7"
      }
    },
    "gifts": {
      "title": {
        "text": "贈送豆子",
        "sourceHash": "5440f4f6ef954605"
      },
      "summary": {
        "text": "無需任何交易即可向他人贈送豆子。",
        "sourceHash": "7eaddf0c6cd54a04"
      }
    },
    "trust-badges": {
      "title": {
        "text": "信任徽章",
        "sourceHash": "a1d8765277383923"
      },
      "summary": {
        "text": "新人、居民、總管和長者。它們的含義以及為什麼它們不解鎖任何權限。",
        "sourceHash": "90926482e87ba9fa"
      }
    },
    "trading-partner-limit": {
      "title": {
        "text": "500 豆夥伴限額",
        "sourceHash": "c40110de7df3670c"
      },
      "summary": {
        "text": "為什麼與多人進行交易比與單一對象大量交易更能建立社群信任。",
        "sourceHash": "ce231d025501d5bc"
      }
    },
    "circulation-fee": {
      "title": {
        "text": "流通費",
        "sourceHash": "e237d280aa62b186"
      },
      "summary": {
        "text": "對高額餘額每月收取的小額費用，以促使豆子保持流通。前 200 豆免收費用。",
        "sourceHash": "c9efbe6aa5cb9873"
      }
    },
    "privacy": {
      "title": {
        "text": "個人隱私",
        "sourceHash": "d2a7115d0455956b"
      },
      "summary": {
        "text": "他人能看到的關於你的資訊，以及控制這些資訊的設定項。",
        "sourceHash": "e4a23a87e82cf7a6"
      },
      "help": {
        "text": "其他成員能看到的關於你的資訊，以及控制這些資訊的開關。",
        "sourceHash": "0a1a1831174d443b"
      }
    },
    "your-area": {
      "title": {
        "text": "所在地區",
        "sourceHash": "b0adfdbb4ce55184"
      },
      "summary": {
        "text": "全球社群向你展示附近刊登所使用的大致位置，以及如何更改或清除該位置。",
        "sourceHash": "de4a8af84def7d30"
      },
      "help": {
        "text": "用於向你展示附近刊登的大致位置。可在此更改或清除；這絕不是你的精確住址。",
        "sourceHash": "f3099801c4d773a5"
      }
    },
    "what-the-admins-can-see": {
      "title": {
        "text": "管理員可見內容",
        "sourceHash": "261de35d8123a845"
      },
      "summary": {
        "text": "在管理員保留實名名單的社群中：名單記錄的內容、誰可以查看、伺服器保留哪些資料以及確認身分的含義。",
        "sourceHash": "5960a4392bb32b4b"
      }
    },
    "admins-ai-assistants": {
      "title": {
        "text": "當管理員使用 AI 助手時",
        "sourceHash": "9180d368e5d11c1e"
      },
      "summary": {
        "text": "所有者或管理員的 AI 助手可以讀取關於你的哪些資訊、絕不會看到什麼，以及資料傳輸給誰。",
        "sourceHash": "d693c47b7b2cbfef"
      }
    },
    "blocking": {
      "title": {
        "text": "封鎖成員",
        "sourceHash": "f2ddac8bd6e31ad5"
      },
      "summary": {
        "text": "向自己隱藏某人的刊登和訊息，並可在日後取消封鎖。",
        "sourceHash": "9e63d5d87e52a1b9"
      },
      "help": {
        "text": "你封鎖的人員名單。他們的刊登和訊息會對你隱藏；可在此取消封鎖。",
        "sourceHash": "baecf7f0bec3735c"
      }
    },
    "reporting": {
      "title": {
        "text": "檢舉問題",
        "sourceHash": "59274c49ac87bb2f"
      },
      "summary": {
        "text": "向社群協調員反映刊登、活動、動態內容、專案或事業方面的問題。",
        "sourceHash": "4b773ef8eef237fa"
      }
    },
    "notifications": {
      "title": {
        "text": "通知設定",
        "sourceHash": "788011833a5a0f22"
      },
      "summary": {
        "text": "選擇哪些提醒會推送到你的手機，以及活動何時向你發出提醒。",
        "sourceHash": "70c8aa586befc843"
      },
      "help": {
        "text": "選擇哪些提醒會推送到你的裝置，以及活動何時向你發出提醒。",
        "sourceHash": "7f7ecf01321aba59"
      }
    },
    "appearance": {
      "title": {
        "text": "外觀模式",
        "sourceHash": "596443341c105af1"
      },
      "summary": {
        "text": "手機端預設為淺色模式，網頁端預設為深色模式。你可以手動調整或跟隨系統設定。",
        "sourceHash": "31cf0aeff28a2052"
      },
      "help": {
        "text": "將應用程式設定為淺色或深色模式，或跟隨你的手機系統。",
        "sourceHash": "1ef643d6832c782a"
      }
    },
    "holiday-mode": {
      "title": {
        "text": "休假模式",
        "sourceHash": "03098a2ccb21c3c2"
      },
      "summary": {
        "text": "在外出時，休假模式會隱藏你的「提供」並暫停接收新的請求。",
        "sourceHash": "53d1ceef93b0a7a1"
      }
    },
    "leaving-or-deleting": {
      "title": {
        "text": "離開或刪除帳號",
        "sourceHash": "6128699c3d7f036a"
      },
      "summary": {
        "text": "從此手機登出，或永久刪除帳號，以及你的豆子將會如何處理。",
        "sourceHash": "d28cb71428dd6615"
      }
    },
    "recovery": {
      "title": {
        "text": "找回你的帳號",
        "sourceHash": "7a6a763f943871ce"
      },
      "summary": {
        "text": "在新手機上復原帳號，並透過連結登入方式為帳號提供額外保護。",
        "sourceHash": "5235d9f9073b2e63"
      },
      "help": {
        "text": "如何在新的手機上找回你的帳號：使用你的 12 個助記詞，或你已連結的登入帳號。",
        "sourceHash": "05fba497e5466e59"
      }
    },
    "check-your-12-words": {
      "title": {
        "text": "助記詞與伺服器金鑰（所有者）",
        "sourceHash": "0a24c7fe8ed3b0a4"
      },
      "summary": {
        "text": "適用於社群所有者。核對 12 個助記詞、用手機接管或復原伺服器，以及手機自身的自動檢查。",
        "sourceHash": "c3a1b3cdc4e7d8df"
      }
    }
  }
}
