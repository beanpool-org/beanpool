++function settlementTransaction<T>(fn: () => T): T {
++    const commonsBefore = getCommonsBalanceExact();
++    try {
++        return db.transaction(fn)();
++    } catch (e) {
++        // The DB has rolled back; resync memory to it rather than leaving the two disagreeing.
++        try {
