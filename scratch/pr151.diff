++    const existing = getSettlement(input.key);
++    if (existing) {
++        if (existing.peerId !== input.peerId || existing.direction !== 'inbound') {
++            return {
++                accepted: false, reason: 'key_conflict',
++                message: 'That settlement reference is already in use.',
++            };
++        }
