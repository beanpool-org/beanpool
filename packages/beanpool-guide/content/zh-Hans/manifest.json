    "joining": {
      "title": {
        "text": "加入 BeanPool",
        "sourceHash": "4a4fa8d50d056023"
      },
      "summary": {
        "text": "两种加入方式：凭成员邀请加入本地社区，或在开放时凭 12 个助记词或一次登录加入全球社区。申请加入社区以及如何邀请他人。",
        "sourceHash": "bfa09f20fea858c6"
      },
      "help": {
        "text": "凭成员邀请加入本地社区，或在开放时凭 12 个助记词或一次登录加入全球社区。",
        "sourceHash": "288300534966c3d2"
      }
    },
    "finding-a-community": {
      "title": {
        "text": "寻找附近的社区",
        "sourceHash": "dbb0b4170f999d18"
      },
      "summary": {
        "text": "从全球社区出发，寻找附近的社区并申请加入，在附近有新社区成立时获得通知，或者自己发起一个社区。",
        "sourceHash": "d7fada0c8e749ecf"
      }
    },
    "beans-and-the-global-community": {
      "title": {
        "text": "豆子与全球社区",
        "sourceHash": "e44e1649e26e9122"
      },
      "summary": {
        "text": "全球社区的用途、众多社区中的一员，以及你在那里看到的内容：🏘️ 本地社区标记、示例社区 Example Valley、为什么豆子在那里等待，以及如何发起或寻找本地社区。",
        "sourceHash": "f91dcd042d53fdfb"
      }
    },
    "global-community-limits": {
      "title": {
        "text": "全球社区的限制",
        "sourceHash": "79186984a4ee4919"
      },
      "summary": {
        "text": "全球社区免费开放，并通过少量限制来维持低成本。内容在最后修改 90 天后归档。每条信息最多 5 张照片，手机保留最近的 500 条信息，你可以关注 3 个地点。",
        "sourceHash": "feba3e6c852b6d3b"
      }
    },
