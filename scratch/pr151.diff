+R:  54 | +  */
+R:  55 | + export const PURCHASE_ASK_TIMEOUT_MS = 10_000;
+R:  56 | + export const RECEIPT_DELIVERY_TIMEOUT_MS = 15_000;
+R:  57 | + export const RESERVATION_TTL_MS = 120_000;
