+R: 280 | +     })();
+R: 281 | + }
+R: 282 | + 
+R: 283 | + /** The peer confirmed it paid its seller. Both bridges agree; nothing left to do but record it. */
+R: 284 | + export function finaliseOutboundSettlement(key: string): SettlementRow {
+R: 285 | +     const row = getSettlement(key);
+R: 286 | +     if (!row) throw new SettlementError(`Unknown settlement ${key}`, 'unknown_settlement');
+R: 287 | +     if (row.state === 'settled') return row;
+R: 288 | +     return advanceSettlement(key, 'settled');
+R: 289 | + }
+R: 290 | + 
+R: 291 | + // ─────────────────────────────────────────────────────────────────────────────────────────────────────
+R: 292 | + // SELLER'S NODE (inbound) — steps 2 and 4
+R: 293 | + // ─────────────────────────────────────────────────────────────────────────────────────────────────────
+R: 294 | + 
+R: 295 | + export type PurchaseDecision =
+R: 296 | +     | { accepted: true; key: string; reservedUntil: string }
+R: 297 | +     | { accepted: false; reason: string; message: string };
+R: 298 | + 
+R: 299 | + /**
+R: 300 | +  * Step 2: the peer asks whether we will accept a purchase from one of their members.
+R: 301 | +  *
+R: 302 | +  * We check our OWN cap on them and reserve against it. We do not pay our seller yet — that needs the
+R: 303 | +  * receipt (Rule 3c). Nothing about the cap is negotiable over the wire: the number comes from our own
+R: 304 | +  * connector record and a peer cannot raise the limit that constrains it (§3.2).
+R: 305 | +  *
+R: 306 | +  * IDEMPOTENCY. An accepted reservation is persisted, so a retried ask returns the same acceptance. A
+R: 307 | +  * refusal is deliberately NOT persisted: refusing is not a commitment, and the honest answer to "will you
+R: 308 | +  * accept now?" may legitimately have changed — headroom returns when the balance moves back.
+R: 309 | +  *
+R: 310 | +  * A key already held for a DIFFERENT peer is refused outright. Keys are minted by the buyer's node, so two
+R: 311 | +  * peers can collide by accident as well as on purpose, and silently answering for the wrong settlement
+R: 312 | +  * would let one peer's receipt be paid out of another's credit line.
+R: 313 | +  */
+R: 314 | + export function handlePurchaseRequest(input: {
+R: 315 | +     key: string;
+R: 316 | +     peerId: string;
+R: 317 | +     buyerPublicKey: string;
+R: 318 | +     buyerCallsign?: string;
+R: 319 | +     buyerHomeNode?: string | null;
+R: 320 | +     sellerPublicKey: string;
+R: 321 | +     postId?: string | null;
+R: 322 | +     amount: number;
+R: 323 | + }): PurchaseDecision {
+R: 324 | +     if (!input.key || typeof input.key !== 'string') {
+R: 325 | +         return { accepted: false, reason: 'invalid_key', message: 'A settlement key is required.' };
+R: 326 | +     }
+R: 327 | +     if (typeof input.amount !== 'number' || !Number.isFinite(input.amount) || input.amount <= 0) {
+R: 328 | +         return { accepted: false, reason: 'invalid_amount', message: 'A settlement amount must be a positive number.' };
+R: 329 | +     }
+R: 330 | +     if (!input.sellerPublicKey || !input.buyerPublicKey) {
+R: 331 | +         return { accepted: false, reason: 'invalid_parties', message: 'Both parties must be identified.' };
+R: 332 | +     }
+R: 333 | + 
+R: 334 | +     const existing = getSettlement(input.key);
+R: 335 | +     if (existing) {
+R: 336 | +         if (existing.peerId !== input.peerId || existing.direction !== 'inbound') {
+R: 337 | +             return {
+R: 338 | +                 accepted: false, reason: 'key_conflict',
+R: 339 | +                 message: 'That settlement reference is already in use.',
+R: 340 | +             };
+R: 341 | +         }
+R: 342 | +         if (existing.state === 'reserved' || existing.state === 'held' || existing.state === 'settled') {
+R: 343 | +             return {
+R: 344 | +                 accepted: true, key: existing.key,
+R: 345 | +                 reservedUntil: existing.reservedUntil ?? new Date(Date.now() + RESERVATION_TTL_MS).toISOString(),
+R: 346 | +             };
+R: 347 | +         }
+R: 348 | +         return {
+R: 349 | +             accepted: false, reason: existing.failureReason ?? 'settlement_closed',
+R: 350 | +             message: 'That purchase was already closed and cannot be reopened.',
+R: 351 | +         };
+R: 352 | +     }
+R: 353 | + 
+R: 354 | +     // The seller must actually be one of ours. Paying a stranger out of a bridge account would mint local
+R: 355 | +     // beans for someone with no local standing — the #102 defect wearing a different hat.
+R: 356 | +     const seller = getMember(input.sellerPublicKey);
+R: 357 | +     if (!seller || seller.homeNodeUrl) {
+R: 358 | +         return {
+R: 359 | +             accepted: false, reason: 'seller_not_local',
+R: 360 | +             message: 'That seller is not a member of this community.',
+R: 361 | +         };
+R: 362 | +     }
+R: 363 | + 
+R: 364 | +     // ...and the buyer must NOT be. Same shape as the `relay_message` impersonation guard (A2-28): the
+R: 365 | +     // connection is trusted, but that authorises the CONNECTION, not the asserted identity.
+R: 366 | +     //
+R: 367 | +     // This one has teeth beyond a bogus trade. Accepting it reaches `registerVisitor`, which stamps a
+R: 368 | +     // `home_node_url` onto an existing member row that has none — quietly converting one of OUR members
+R: 369 | +     // into a visitor. `assertLocalSettlement` then refuses that member's own local spending (#102). So any
+R: 370 | +     // peer that knows a local member's public key could freeze their account by naming them as a buyer.
+R: 371 | +     const claimedBuyer = getMember(input.buyerPublicKey);
+R: 372 | +     if (claimedBuyer && !claimedBuyer.homeNodeUrl) {
+R: 373 | +         console.warn(`[Federation] Peer ${input.peerId.slice(-8)} claimed local member ${input.buyerPublicKey.slice(0, 8)} as a cross-node buyer`);
+R: 374 | +         return {
+R: 375 | +             accepted: false, reason: 'buyer_is_local',
+R: 376 | +             message: 'That buyer is a member of this community, so their purchase is settled here, not across nodes.',
+R: 377 | +         };
+R: 378 | +     }
+R: 379 | + 
+R: 380 | +     const capacity = settlementCapacityForPeer(input.peerId, input.amount);
+R: 381 | +     if (!capacity.ok) return { accepted: false, reason: capacity.reason, message: capacity.message };
+R: 382 | + 
+R: 383 | +     const reservedUntil = new Date(Date.now() + RESERVATION_TTL_MS).toISOString();
+R: 384 | + 
+R: 385 | +     // The seller needs to know who they are serving, and a visitor record is how a cross-community
+R: 386 | +     // counterparty already renders in the clients. Tagged with their home node so it is never confused
+R: 387 | +     // with a local member.
+R: 388 | +     try {
+R: 389 | +         registerVisitor(input.buyerPublicKey, input.buyerCallsign, input.buyerHomeNode ?? undefined);
+R: 390 | +     } catch (e: any) {
+R: 391 | +         console.warn('[Federation] Visitor record for cross-node buyer failed:', e?.message || e);
+R: 392 | +     }
+R: 393 | + 
+R: 394 | +     openSettlement({
+R: 395 | +         key: input.key,
+R: 396 | +         direction: 'inbound',
+R: 397 | +         peerId: input.peerId,
+R: 398 | +         buyerPubkey: input.buyerPublicKey,
+R: 399 | +         buyerHomeNode: input.buyerHomeNode ?? null,
+R: 400 | +         sellerPubkey: input.sellerPublicKey,
+R: 401 | +         postId: input.postId ?? null,
+R: 402 | +         amount: round4(input.amount),
+R: 403 | +         reservedUntil,
+R: 404 | +         state: 'reserved',
+R: 405 | +     });
+R: 406 | + 
+R: 407 | +     return { accepted: true, key: input.key, reservedUntil };
+R: 408 | + }
+R: 409 | + 
+R: 410 | + export type ReceiptOutcome =
+R: 411 | +     | { settled: true; key: string }
+R: 412 | +     | { settled: false; reason: string; message: string };
+R: 413 | + 
+R: 414 | + /**
+R: 415 | +  * Step 4a: persist an arriving receipt, then attempt payment.
+R: 416 | +  *
+R: 417 | +  * Persist-then-pay is the order that makes payment REPLAYABLE (§2.5): a crash mid-payment resumes from the
+R: 418 | +  * stored receipt instead of losing the fact that we owe our seller. So `held` is committed on its own,
+R: 419 | +  * before any ledger write.
+R: 420 | +  *
+R: 421 | +  * Everything the receipt claims is re-checked against what we reserved. A receipt is a bearer instrument
+R: 422 | +  * for a local mint, so it must not be able to name a different amount, a different seller, or a different
+R: 423 | +  * peer than the reservation it settles — each of those would route real beans somewhere the cap check
+R: 424 | +  * never authorised.
+R: 425 | +  */
+R: 426 | + export async function handleReceiptDelivery(input: {
+R: 427 | +     key: string;
+R: 428 | +     receipt: SettlementReceipt;
+R: 429 | +     signature: string;
+R: 430 | +     peerId: string;
+R: 431 | + }): Promise<ReceiptOutcome> {
+R: 432 | +     const row = getSettlement(input.key);
+R: 433 | +     if (!row) {
+R: 434 | +         return { settled: false, reason: 'NOT_FOUND', message: 'No reservation exists for that settlement.' };
+R: 435 | +     }
+R: 436 | +     if (row.direction !== 'inbound' || row.peerId !== input.peerId) {
+R: 437 | +         return { settled: false, reason: 'NOT_FOUND', message: 'That settlement does not belong to this peer.' };
+R: 438 | +     }
+R: 439 | +     if (row.state === 'settled') return { settled: true, key: row.key };          // idempotent redelivery
+R: 440 | +     if (row.state === 'reversed' || row.state === 'abandoned') {
+R: 441 | +         return {
+R: 442 | +             settled: false,
+R: 443 | +             reason: row.failureReason ?? 'CAPACITY_LAPSED',
+R: 444 | +             message: 'That reservation is no longer open, so this purchase was not completed.',
+R: 445 | +         };
+R: 446 | +     }
+R: 447 | + 
+R: 448 | +     // Bind the receipt to the peer that presented it, and to the reservation it claims to settle.
+R: 449 | +     const ok = await verifyReceipt(input.receipt, input.signature, input.peerId);
+R: 450 | +     if (!ok) {
+R: 451 | +         return { settled: false, reason: 'BAD_SIGNATURE', message: 'That settlement receipt could not be verified.' };
+R: 452 | +     }
+R: 453 | +     const r = input.receipt;
+R: 454 | +     const matches = r.key === row.key
+R: 455 | +         && round4(r.amount) === round4(row.amount)
+R: 456 | +         && r.buyerPublicKey === row.buyerPubkey
+R: 457 | +         && r.sellerPublicKey === (row.sellerPubkey ?? '')
+R: 458 | +         && (r.postId ?? null) === (row.postId ?? null);
+R: 459 | +     if (!matches) {
+R: 460 | +         return { settled: false, reason: 'RECEIPT_MISMATCH', message: 'That receipt does not match the reserved purchase.' };
+R: 461 | +     }
+R: 462 | + 
+R: 463 | +     if (row.state === 'reserved') advanceSettlement(row.key, 'held', { receipt: input.signature });
+R: 464 | +     return settleHeldReceipt(row.key);
+R: 465 | + }
+R: 466 | + 
+R: 467 | + /**
+R: 468 | +  * Step 4b: pay our seller from the peer's bridge account, or refuse with `CAPACITY_LAPSED`.
+R: 469 | +  *
+R: 470 | +  * Split out from delivery because boot recovery calls it directly, with no network and no receipt to
+R: 471 | +  * re-verify — the `held` row already is the verified receipt.
+R: 472 | +  *
+R: 473 | +  * The cap is re-evaluated HERE, atomically, and not trusted from the reservation. A slow network or a
+R: 474 | +  * sleeping VM can land a receipt late, and paying blindly could push us past the number our operator
+R: 475 | +  * chose. That makes a reservation *a hint that reduces headroom*, not a promise — the right shape, since a
+R: 476 | +  * node's own cap is the only authority on what it may extend and should never be bound by a decision it
+R: 477 | +  * made in the past.
+R: 478 | +  */
+R: 479 | + export function settleHeldReceipt(key: string): ReceiptOutcome {
+R: 480 | +     const row = getSettlement(key);
+R: 481 | +     if (!row) return { settled: false, reason: 'NOT_FOUND', message: 'No such settlement.' };
+R: 482 | +     if (row.state === 'settled') return { settled: true, key };
+R: 483 | +     if (row.state !== 'held') {
+R: 484 | +         return { settled: false, reason: 'wrong_state', message: `Settlement is ${row.state}, not awaiting payment.` };
+R: 485 | +     }
+R: 486 | +     if (!row.sellerPubkey) {
+R: 487 | +         return { settled: false, reason: 'seller_unknown', message: 'No seller recorded for that settlement.' };
+R: 488 | +     }
+R: 489 | + 
+R: 490 | +     const capacity = settlementCapacityForPeer(row.peerId, row.amount);
+R: 491 | +     if (!capacity.ok) {
+R: 492 | +         // Do NOT pay. Mark it reversed so the buyer's node can compensate its own entries; on this side
+R: 493 | +         // there is nothing to compensate, because nothing was ever paid out.
+R: 494 | +         advanceSettlement(key, 'reversed', { failureReason: 'CAPACITY_LAPSED' });
+R: 495 | +         return { settled: false, reason: 'CAPACITY_LAPSED', message: capacity.message };
+R: 496 | +     }
+R: 497 | + 
+R: 498 | +     ensureBridgeAccount(row.peerId);
+R: 499 | + 
+R: 500 | +     return db.transaction((): ReceiptOutcome => {
+R: 501 | +         // The seller receives exactly the agreed amount — fee-exempt, because the buyer already paid the
+R: 502 | +         // fee on their own node and it never crossed the border.
+R: 503 | +         mustTransfer(
+R: 504 | +             bridgeAccountId(row.peerId), row.sellerPubkey!, row.amount,
+R: 505 | +             `Cross-community sale (${key})`,
+R: 506 | +         );
