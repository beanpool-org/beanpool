{
  "expo": {
    "name": "BeanPool",
    "slug": "beanpool-pillar",
    "version": "1.2.84",
    "orientation": "default",
    "icon": "./assets/images/app-icon.png",
    "scheme": "beanpool",
    "locales": {
      "en": "./infoplist-words/en.json",
      "es": "./infoplist-words/es.json",
      "pt": "./infoplist-words/pt.json",
      "hi": "./infoplist-words/hi.json",
      "bn": "./infoplist-words/bn.json",
      "fr": "./infoplist-words/fr.json",
      "ar": "./infoplist-words/ar.json",
      "id": "./infoplist-words/id.json",
      "ru": "./infoplist-words/ru.json",
      "zh-Hans": "./infoplist-words/zh-Hans.json",
      "zh-Hant": "./infoplist-words/zh-Hant.json",
      "it": "./infoplist-words/it.json",
      "de": "./infoplist-words/de.json",
      "tr": "./infoplist-words/tr.json",
      "sw": "./infoplist-words/sw.json",
      "ml": "./infoplist-words/ml.json",
      "ta": "./infoplist-words/ta.json",
      "uk": "./infoplist-words/uk.json",
      "ur": "./infoplist-words/ur.json",
      "fa": "./infoplist-words/fa.json",
      "vi": "./infoplist-words/vi.json",
      "el": "./infoplist-words/el.json",
      "fil": "./infoplist-words/fil.json",
      "ja": "./infoplist-words/ja.json",
      "ko": "./infoplist-words/ko.json"
    },
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#ffffff",
      "image": "./assets/images/logo.png",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "org.beanpool.pillar",
      "buildNumber": "248",
      "associatedDomains": [
        "applinks:beanpool.org",
        "applinks:*.beanpool.org"
      ],
      "infoPlist": {
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait"
        ],
        "UIBackgroundModes": [
          "fetch"
        ],
        "NSLocationWhenInUseUsageDescription": "BeanPool uses your location while you use the app, to centre the map and show communities, listings and events near you. You can type your town instead.",
        "NSCameraUsageDescription": "BeanPool uses your camera to scan device pairing QR codes and community invites.",
        "NSFaceIDUsageDescription": "BeanPool asks for Face ID before sensitive steps, such as opening your community's admin settings or showing your recovery phrase.",
        "NSLocalNetworkUsageDescription": "BeanPool uses this to reach your community's laptop on the hall Wi-Fi when the internet is down.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "485XM2R33S"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 306,
      "package": "org.beanpool.pillar",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.DETECT_SCREEN_CAPTURE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "beanpool.org",
              "pathPrefix": "/auth/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "beanpool.org",
              "pathPrefix": "/global"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "autoVerify": true,
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "*.beanpool.org",
              "path": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "./plugins/withAndroidLargeHeap",
      "./plugins/withAppLanguages",
      "./plugins/withPodDeploymentTarget",
      "expo-router",
      "expo-notifications",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "BeanPool uses your camera to scan device pairing QR codes and community invites."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BeanPool requires photo library access so you can select and upload photos of items or services you are offering on the community marketplace.",
          "cameraPermission": "BeanPool requires camera access so you can take and upload photos of items or services you are offering on the community marketplace."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "minSdkVersion": 26
          }
        }
      ],
      "expo-sqlite",
      "expo-system-ui",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BeanPool uses your location while you use the app, to centre the map and show communities, listings and events near you. You can type your town instead.",
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-sharing",
      "expo-apple-authentication",
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "17a2a61a-9cbe-457e-bb10-84d8a666e6eb"
      }
    }
  }
}
