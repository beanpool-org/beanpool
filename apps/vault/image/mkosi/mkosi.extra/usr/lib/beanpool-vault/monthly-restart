#!/bin/sh
# The monthly restart (beanpool-vault-monthly-restart.timer). Root's install step (vault-install.mjs, built with the
# genesis custodian keys, on the verified system partition) checks what the API staged in its inbox from those keys:
# two custodian signatures, newer than the running release, the file names, the UKI's SHA-256 and veritysetup verify
# against the release's root hash. Only a new image that passes all of them reaches systemd-sysupdate, which writes it
# into the other slot (usr/lib/sysupdate.d); systemd-boot boots it next, and the slot in use is kept to fall back to.
# Anything else is refused and logged; root unlinks the inbox's files, and the API clears anything else in it (a
# directory, a link) at its next check. Then the machine restarts, and the vault waits locked for two custodians.
set -u
/opt/node/bin/node /usr/lib/beanpool-vault/vault-install.mjs || echo "monthly restart: no new image installed; restarting the current one"
echo "monthly restart: restarting now"
systemctl reboot
