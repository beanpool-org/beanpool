++export function handlePurchaseRequest(input: {
++    key: string;
++    peerId: string;
++    buyerPublicKey: string;
++    buyerCallsign?: string;
++    buyerHomeNode?: string | null;
++    sellerPublicKey: string;
++    postId?: string | null;
++    amount: number;
