#!/bin/sh
# Lists the system tree as it goes into the image, so two builds (on two machines) can be compared file by file:
# every file's SHA-256, every symlink's target, and every entry's mode and owner. build.sh leaves it in
# <out>/root-files.txt. It changes nothing in the image.
set -eu
cd "$BUILDROOT"
out="$OUTPUTDIR/beanpool-vault.root-files.txt"
{
    find . -xdev -type f ! -path './var/*' ! -path './boot/*' ! -path './efi/*' -print0 | LC_ALL=C sort -z | xargs -0 -r sha256sum
    find . -xdev -type l ! -path './var/*' -printf 'link %p -> %l\n' | LC_ALL=C sort
    find . -xdev ! -path './var/*' ! -path './boot/*' ! -path './efi/*' -printf 'meta %m %U:%G %y %p\n' | LC_ALL=C sort
} > "$out"
