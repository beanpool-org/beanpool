++    openSettlement({
++        key: input.key,
++        direction: 'inbound',
++        peerId: input.peerId,
++        buyerPubkey: input.buyerPublicKey,
++        buyerHomeNode: input.buyerHomeNode ?? null,
++        sellerPubkey: input.sellerPublicKey,
++        postId: input.postId ?? null,
++        amount: round4(input.amount),
++        reservedUntil,
++        state: 'reserved',
++    });
