+R: 516 | +     // NOT_FOUND instructs the asker to REVERSE, so defaulting to it would let a fabricated or truncated
+R: 517 | +     // key talk a node into undoing a trade that actually settled.
+R: 518 | +     if (!row || row.peerId !== askingPeerId) return 'UNKNOWN';
+R: 519 | +     return receiptStatus(key);
+R: 520 | + }
+R: 521 | + 
+R: 522 | + /**
+R: 523 | +  * Release inbound reservations that lapsed with no receipt, returning the headroom they were holding.
+R: 524 | +  *
+R: 525 | +  * Free to do: a reservation moves no beans on either side. A receipt arriving after this is not lost — it
+R: 526 | +  * is answered with `CAPACITY_LAPSED` and the buyer's node compensates.
+R: 527 | +  */
