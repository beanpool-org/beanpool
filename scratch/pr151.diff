+R: 541 | + // ─────────────────────────────────────────────────────────────────────────────────────────────────────
+R: 542 | + // BOOT RECOVERY
+R: 543 | + // ─────────────────────────────────────────────────────────────────────────────────────────────────────
+R: 544 | + 
+R: 545 | + export interface RecoveryResult {
+R: 546 | +     expired: number;
+R: 547 | +     paid: number;
+R: 548 | +     refunded: number;
+R: 549 | +     reversed: number;
+R: 550 | +     finalised: number;
+R: 551 | +     stillOpen: number;
+R: 552 | + }
+R: 553 | + 
+R: 554 | + /**
+R: 555 | +  * Resolve every unfinalised settlement at boot. This is what makes "recoverable by replay" true rather
+R: 556 | +  * than aspirational (§2.5).
+R: 557 | +  *
+R: 558 | +  * DELIBERATELY NOT GATED on `FEDERATION_SETTLEMENT_ENABLED`. Turning settlement off is a decision about
+R: 559 | +  * accepting NEW cross-node trades; it must not strand beans already sitting in escrow or a seller already
+R: 560 | +  * owed money. An operator flipping the flag off is the most likely moment for in-flight rows to exist.
+R: 561 | +  *
+R: 562 | +  * @param askPeer resolves `GET_RECEIPT_STATUS` for an outbound row. Omitted (or throwing) leaves those
+R: 563 | +  *                rows alone for the next boot — waiting is always safe, reversing on a guess is not.
+R: 564 | +  */
+R: 565 | + export async function recoverSettlements(
+R: 566 | +     askPeer?: (peerId: string, key: string) => Promise<ReceiptStatus>,
+R: 567 | + ): Promise<RecoveryResult> {
+R: 568 | +     const result: RecoveryResult = { expired: 0, paid: 0, refunded: 0, reversed: 0, finalised: 0, stillOpen: 0 };
+R: 569 | + 
+R: 570 | +     result.expired = expireStaleReservations();
+R: 571 | + 
+R: 572 | +     for (const row of unfinalisedSettlements()) {
+R: 573 | +         try {
+R: 574 | +             if (row.direction === 'inbound') {
+R: 575 | +                 // We hold a verified receipt and owe our seller. No network needed — replay the payment.
+R: 576 | +                 if (row.state === 'held') {
+R: 577 | +                     if (settleHeldReceipt(row.key).settled) result.paid++;
+R: 578 | +                     else result.reversed++;
+R: 579 | +                 } else {
+R: 580 | +                     result.stillOpen++;      // 'reserved' — still within its hold, wait for the receipt
+R: 581 | +                 }
+R: 582 | +                 continue;
+R: 583 | +             }
+R: 584 | + 
+R: 585 | +             // Outbound. An `escrowed` row means we crashed after taking the buyer's beans and before
+R: 586 | +             // asking the peer. Nothing crossed the border, and the buyer has long since seen an error and
+R: 587 | +             // moved on, so refund rather than hold their beans hostage to a purchase nobody is waiting on.
+R: 588 | +             if (row.state === 'escrowed') {
+R: 589 | +                 abandonOutboundSettlement(row.key, 'INTERRUPTED_BEFORE_ASK');
+R: 590 | +                 result.refunded++;
+R: 591 | +                 continue;
+R: 592 | +             }
+R: 593 | + 
+R: 594 | +             // `committed` — we wrote real entries and issued a receipt but never learned what became of
+R: 595 | +             // it. Only the peer knows.
+R: 596 | +             if (!askPeer) { result.stillOpen++; continue; }
+R: 597 | + 
+R: 598 | +             const status = await askPeer(row.peerId, row.key);
+R: 599 | +             switch (actionForReceiptStatus(status)) {
+R: 600 | +                 case 'finalise': finaliseOutboundSettlement(row.key); result.finalised++; break;
+R: 601 | +                 case 'reverse':  reverseOutboundSettlement(row.key, 'RECEIPT_NOT_FOUND'); result.reversed++; break;
+R: 602 | +                 case 'wait':     result.stillOpen++; break;
+R: 603 | +             }
+R: 604 | +         } catch (e: any) {
+R: 605 | +             // One unrecoverable row must not stop the rest. Left unfinalised, so the next boot retries.
+R: 606 | +             console.warn(`[Federation] Settlement recovery failed for ${row.key}:`, e?.message || e);
+R: 607 | +             result.stillOpen++;
+R: 608 | +         }
+R: 609 | +     }
