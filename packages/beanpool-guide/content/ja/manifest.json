    },
    "your-balance": {
      "title": {
        "text": "残高と履歴",
        "sourceHash": "fb3a96eb2bfcd2a8"
      },
      "summary": {
        "text": "保有している豆の数、保留中の分、すべての取引とギフトの履歴です。",
        "sourceHash": "61df521108b36035"
      },
      "help": {
        "text": "あなたの豆：保有額、取引で保留中の額、すべての取引とギフト。全員がゼロからスタートします。",
        "sourceHash": "a40a5f9fef426c85"
      }
    },
    "credit-line": {
      "title": {
        "text": "信用枠",
        "sourceHash": "dd11b44ecc1037c9"
      },
      "summary": {
        "text": "残高をどこまでマイナスにできるか、またその枠がどのように増えるかを説明します。",
        "sourceHash": "18b609abc63667e7"
      }
    },
    "gifts": {
      "title": {
        "text": "ギフトを送る",
        "sourceHash": "5440f4f6ef954605"
      },
      "summary": {
        "text": "取引を伴わずに、誰かに豆をプレゼントします。",
        "sourceHash": "7eaddf0c6cd54a04"
      }
    },
    "trust-badges": {
      "title": {
        "text": "信頼バッジ",
        "sourceHash": "a1d8765277383923"
      },
      "summary": {
        "text": "新規、住民、世話人、長老。それぞれの意味と、特権が付与されるわけではない理由を説明します。",
        "sourceHash": "90926482e87ba9fa"
      }
    },
    "trading-partner-limit": {
      "title": {
        "text": "取引相手ごとの500豆制限",
        "sourceHash": "c40110de7df3670c"
      },
      "summary": {
        "text": "特定の人と多額の取引をするより、多くの人と取引する方が信頼を築ける理由を説明します。",
        "sourceHash": "ce231d025501d5bc"
      }
    },
    "circulation-fee": {
      "title": {
        "text": "流通手数料",
        "sourceHash": "e237d280aa62b186"
      },
      "summary": {
        "text": "豆の循環を促すための、高額残高に対する少額の月額手数料です。最初の200豆は無料です。",
        "sourceHash": "c9efbe6aa5cb9873"
      }
    },
    "privacy": {
      "title": {
        "text": "プライバシー",
        "sourceHash": "d2a7115d0455956b"
      },
      "summary": {
        "text": "他のメンバーに公開される情報と、それを管理する設定について説明します。",
        "sourceHash": "e4a23a87e82cf7a6"
      },
      "help": {
        "text": "他のメンバーに表示されるあなたの情報と、それを切り替える設定です。",
        "sourceHash": "0a1a1831174d443b"
      }
    },
    "your-area": {
      "title": {
        "text": "お住まいの地域",
        "sourceHash": "b0adfdbb4ce55184"
      },
      "summary": {
        "text": "グローバルコミュニティが近くの投稿を表示するために使用するおおよその地域と、その変更や消去方法について説明します。",
        "sourceHash": "de4a8af84def7d30"
      },
      "help": {
        "text": "近くの投稿を表示するためのおおよその地域です。ここで変更や削除ができます。正確な住所ではありません。",
        "sourceHash": "f3099801c4d773a5"
      }
    },
    "what-the-admins-can-see": {
      "title": {
        "text": "管理者が確認できる情報",
        "sourceHash": "261de35d8123a845"
      },
      "summary": {
        "text": "管理者が名簿を保持しているコミュニティにおいて、記録される情報、閲覧権限、サーバーの保持情報、認証済みの意味を説明します。",
        "sourceHash": "5960a4392bb32b4b"
      }
    },
    "admins-ai-assistants": {
      "title": {
        "text": "管理者がAIアシスタントを使う場合",
        "sourceHash": "9180d368e5d11c1e"
      },
      "summary": {
        "text": "オーナーや管理者のAIアシスタントが確認できる情報、決して見られない情報、送信先について説明します。",
        "sourceHash": "d693c47b7b2cbfef"
      }
    },
    "blocking": {
      "title": {
        "text": "ユーザーのブロック",
        "sourceHash": "f2ddac8bd6e31ad5"
      },
      "summary": {
        "text": "特定の人の投稿やメッセージを非表示にし、後から解除する方法について説明します。",
        "sourceHash": "9e63d5d87e52a1b9"
      },
      "help": {
        "text": "ブロックしたユーザーです。相手の投稿やメッセージは非表示になります。ここで解除できます。",
        "sourceHash": "baecf7f0bec3735c"
      }
    },
    "reporting": {
      "title": {
        "text": "問題の通報",
        "sourceHash": "59274c49ac87bb2f"
      },
      "summary": {
        "text": "投稿、イベント、パルスの投稿、プロジェクト、事業体についてコミュニティのモデレーターに通報します。",
        "sourceHash": "4b773ef8eef237fa"
      }
    },
    "notifications": {
      "title": {
        "text": "通知設定",
        "sourceHash": "788011833a5a0f22"
      },
      "summary": {
        "text": "スマートフォンに届く通知と、イベントのリマインダーを受け取るタイミングを選択します。",
        "sourceHash": "70c8aa586befc843"
      },
      "help": {
        "text": "受け取る通知や、イベントのリマインダーを受け取るタイミングを選択できます。",
        "sourceHash": "7f7ecf01321aba59"
      }
    },
    "appearance": {
      "title": {
        "text": "ライトとダーク",
        "sourceHash": "596443341c105af1"
      },
      "summary": {
        "text": "スマートフォンアプリはライト、Webアプリはダークで始まります。変更したり、端末の設定に合わせることができます。",
        "sourceHash": "31cf0aeff28a2052"
      },
      "help": {
        "text": "アプリをライトまたはダークに設定するか、端末の設定に合わせます。",
        "sourceHash": "1ef643d6832c782a"
      }
    },
    "holiday-mode": {
      "title": {
        "text": "お休み",
        "sourceHash": "03098a2ccb21c3c2"
      },
      "summary": {
        "text": "お休みモードは、不在中に提供を非表示にし、新しいリクエストを一時停止します。",
        "sourceHash": "53d1ceef93b0a7a1"
      }
    },
    "leaving-or-deleting": {
      "title": {
        "text": "アカウントの退会または削除",
        "sourceHash": "6128699c3d7f036a"
      },
      "summary": {
        "text": "この端末からサインアウトするか、アカウントを完全に削除します。その際の豆の扱いについても説明します。",
        "sourceHash": "d28cb71428dd6615"
      }
    },
    "recovery": {
      "title": {
        "text": "アカウントの復元",
        "sourceHash": "7a6a763f943871ce"
      },
      "summary": {
        "text": "新しい端末でアカウントを復元し、連携したサインインアカウントで保護します。",
        "sourceHash": "5235d9f9073b2e63"
      },
      "help": {
        "text": "新しい端末でアカウントを復元する方法：12個の単語、または連携したサインインアカウントを使用します。",
        "sourceHash": "05fba497e5466e59"
      }
    },
    "check-your-12-words": {
      "title": {
        "text": "12個の単語とサーバーの鍵（オーナー用）",
        "sourceHash": "0a24c7fe8ed3b0a4"
      },
      "summary": {
        "text": "コミュニティのオーナー向け。12個の単語の確認、スマートフォンによるサーバーの引き継ぎや復元、端末による自動確認について説明します。",
        "sourceHash": "c3a1b3cdc4e7d8df"
      }
    }
  }
}
