+R: 238 | +     const row = getSettlement(key);
+R: 239 | +     if (!row) throw new SettlementError(`Unknown settlement ${key}`, 'unknown_settlement');
+R: 240 | +     if (row.state === 'reversed') return row;                       // idempotent
+R: 241 | +     if (row.direction !== 'outbound') {
+R: 242 | +         throw new SettlementError(`${key} is not ours to reverse`, 'wrong_direction');
+R: 243 | +     }
+R: 244 | +     if (row.state !== 'committed') {
+R: 245 | +         throw new SettlementError(`${key} is ${row.state}, not reversible`, 'wrong_state');
+R: 246 | +     }
+R: 247 | + 
+R: 248 | +     const bridge = bridgeAccountId(row.peerId);
+R: 249 | + 
+R: 250 | +     return db.transaction(() => {
+R: 251 | +         mustTransfer(bridge, row.buyerPubkey, row.amount, `Reversed cross-community purchase (${key})`);
+R: 252 | +         // Drawn from the Commons pot, not from the shadow account — otherwise the refund is funded from
+R: 253 | +         // nowhere and the node's books stop balancing. Refusing here (rather than skipping the fee) keeps
+R: 254 | +         // the reversal all-or-nothing: a partial refund is worse than a retry.
+R: 255 | +         if (row.fee > 0 && !payFromCommons(row.buyerPubkey, row.fee, `Refunded cross-community fee (${key})`)) {
+R: 256 | +             throw new SettlementError(`Commons cannot cover the fee refund for ${key}`, 'fee_refund_failed');
+R: 257 | +         }
+R: 258 | +         return advanceSettlement(key, 'reversed', { failureReason: reason });
+R: 259 | +     })();
+R: 260 | + }
+R: 261 | + 
+R: 262 | + /**
+R: 263 | +  * Release an escrow hold for a purchase the peer never accepted. Nothing crossed the border, so this is a
+R: 264 | +  * plain refund rather than a compensating entry — there is nothing to compensate.
+R: 265 | +  */
+R: 266 | + export function abandonOutboundSettlement(key: string, reason: string): SettlementRow {
+R: 267 | +     const row = getSettlement(key);
