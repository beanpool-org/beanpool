+R: 274 | +     return db.transaction(() => {
+R: 275 | +         mustTransfer(
+R: 276 | +             escrowAccountFor(key), row.buyerPubkey, round4(row.amount + row.fee),
+R: 277 | +             `Released cross-community hold (${key})`,
+R: 278 | +         );
