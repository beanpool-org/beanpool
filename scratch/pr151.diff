+R: 508 | +         return { settled: true, key };
+R: 509 | +     })();
+R: 510 | + }
+R: 511 | + 
+R: 512 | + /** The `GET_RECEIPT_STATUS(key)` answer. Scoped to the asking peer so no peer can probe another's keys. */
+R: 513 | + export function answerReceiptStatus(key: string, askingPeerId: string): ReceiptStatus {
+R: 514 | +     const row = getSettlement(key);
