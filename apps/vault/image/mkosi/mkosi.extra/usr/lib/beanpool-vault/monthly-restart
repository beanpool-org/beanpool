#!/bin/sh
# The monthly restart (beanpool-vault-monthly-restart.timer). Root's install step (vault-install.mjs, built with the
# genesis custodian keys, on the verified system partition) first stops the API (the machine restarts next anyway)
# and, once no process of the API's user runs, removes what that user left on the state partition: the releases it
# downloaded, anything in backups/ that isn't a backup (and, but for the newest, the backups past their budget),
# everything in restore/ unless the keyholder marks a restore from backup pending (then its file and partial file
# stay), and anything in the inbox but a staged image's files. Then it checks what the API staged there
# from those keys: two custodian signatures, newer than the running release, the file names, the UKI's SHA-256 and
# veritysetup verify against the release's root hash. Only a new image that passes all of them reaches
# systemd-sysupdate, which writes it into the other slot (usr/lib/sysupdate.d); systemd-boot boots it next, and the
# slot in use is kept to fall back to. Anything else is refused, logged and removed. Then the machine restarts, and
# the vault waits locked for two custodians.
set -u
/opt/node/bin/node /usr/lib/beanpool-vault/vault-install.mjs || echo "monthly restart: no new image installed; restarting the current one"
echo "monthly restart: restarting now"
# (Should the restart not start, the API comes back rather than stay stopped.)
systemctl reboot || systemctl start beanpool-vault-api.service
