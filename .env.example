# BeanPool Environment Variables
# Copy to .env and fill in your values

CF_API_TOKEN=your-cloudflare-api-token
CF_ZONE_ID=your-cloudflare-zone-id

# Used for Universal Links in the apple-app-site-association file
# Get this 10-character code from the Apple Developer Portal -> Membership Details
APPLE_TEAM_ID=your-10-char-apple-team-id

# --- Federation (#143) --------------------------------------------------------
# Both OFF unless explicitly set to the string "true". Set these in a NODE'S OWN
# .env on the box (deploy.sh preserves it across redeploys), not here — federation
# is opted into per node, not fleet-wide.
#
#   ENABLE_PEER_CONNECTORS  this node talks to peer nodes at all
#   FEDERATION_SETTLEMENT   this node accepts NEW cross-node trades. Turning it
#                           back off still completes trades already in flight, so
#                           it never strands committed beans.
ENABLE_PEER_CONNECTORS=
FEDERATION_SETTLEMENT=

# --- Image store (storage design §7) -------------------------------------------
# Where photos and message attachments live. Leave IMAGE_STORE unset for the
# default: on this node's own disk, beside state.db (data/images). Nothing to
# sign up for; that is what every local node uses.
#
# IMAGE_STORE=s3 keeps them in an S3-compatible bucket instead (Cloudflare R2
# first; the global node). All five IMAGE_S3_* values are then required, from
# the environment only: they are never stored in node_config and never put in
# a backup. The node REFUSES TO START if any is missing, if the bucket cannot
# be reached with them, on a standby, or while this node still has photos on
# its own disk (moving a node from disk to a bucket needs the migration tool,
# which is not in this version).
#
#   IMAGE_S3_ENDPOINT           https://<account-id>.r2.cloudflarestorage.com  (no path)
#   IMAGE_S3_BUCKET             the bucket name
#   IMAGE_S3_REGION             auto  (for R2)
#   IMAGE_S3_ACCESS_KEY_ID      an R2 API token's access key id (read + write on that bucket)
#   IMAGE_S3_SECRET_ACCESS_KEY  its secret
IMAGE_STORE=
IMAGE_S3_ENDPOINT=
IMAGE_S3_BUCKET=
IMAGE_S3_REGION=
IMAGE_S3_ACCESS_KEY_ID=
IMAGE_S3_SECRET_ACCESS_KEY=
