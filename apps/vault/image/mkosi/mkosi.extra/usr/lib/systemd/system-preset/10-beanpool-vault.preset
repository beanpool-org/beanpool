# What runs on the vault, applied when the image is built: these, and nothing else a package would enable (Debian's
# own preset enables everything). Among what stays off: systemd-sysupdate's timers (a staged image is installed only
# by the monthly restart), systemd-sysext and -confext (they would lay files from the writable /var over the verified
# system), systemd-pstore, the TPM pcrlock services, systemd-boot-update, caddy-api, e2scrub.
enable dbus-broker.service
enable systemd-networkd.service
enable systemd-networkd.socket
enable systemd-networkd-wait-online.service
enable systemd-timesyncd.service
enable systemd-repart.service
enable run-lock.mount
enable nftables.service
enable caddy.service
enable beanpool-vault-dns.service
enable beanpool-vault-egress.service
enable beanpool-vault-egress.path
enable beanpool-vault-identity.service
enable beanpool-vault-keyholder.service
enable beanpool-vault-api.service
enable beanpool-vault-data.service
enable beanpool-vault-hygiene.service
enable beanpool-vault-monthly-restart.timer
disable *
