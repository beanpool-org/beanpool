+R: 532 | +             advanceSettlement(row.key, 'abandoned', { failureReason: 'RESERVATION_EXPIRED' });
+R: 533 | +         } catch (e: any) {
+R: 534 | +             console.warn(`[Federation] Could not expire reservation ${row.key}:`, e?.message || e);
+R: 535 | +         }
+R: 536 | +     }
