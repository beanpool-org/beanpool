pc-api-key.json

# Ignore Expo generated native directories
apps/native/ios/
apps/native/android/
apps/native/prod.keystore
*.aab
*.ipa

# Signing keys and certificate bundles. Mirrors .gitignore — EAS uses THIS file
# INSTEAD of .gitignore, so a rule added only there does nothing for what gets
# uploaded in a build archive. `eas build --local` archives the working tree, so
# an untracked key sitting in the workspace would ship without ever being
# committed. p12/pfx are the export format for certificates WITH their private
# key, which is why they belong here next to prod.keystore.
*.p8
*.pem
*.key
*.p12
*.pfx

# NOTE: google-services.json is intentionally NOT excluded here
# so that EAS local builds can include it in the archive.
