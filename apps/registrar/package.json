{
  "name": "@beanpool/registrar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker that leases <name>.beanpool.org to community nodes (tunnel/direct), with attestation.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "node -e \"console.log('registrar build ok')\"",
    "test": "node --test test/registrar.test.js test/adversarial.test.js test/incident-2026-09-24.test.js test/ownership-states.test.js",
    "db:create": "wrangler d1 create beanpool-registrar",
    "db:init": "wrangler d1 migrations apply beanpool-registrar --local"
  },
  "devDependencies": {
    "wrangler": "^3"
  }
}
