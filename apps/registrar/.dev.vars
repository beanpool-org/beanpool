# wrangler.toml's [vars] put our registrar behind Cloudflare Access (README "Admin sign-in"). Emptied here, so
# `wrangler dev` signs in with ADMIN_SECRET above: .dev.vars overrides [vars] locally, and an empty value counts as
# unset (src/access.js).
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
ADMIN_EMAILS=
