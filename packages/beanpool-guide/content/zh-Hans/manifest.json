      "title": {
        "text": "你的 12 个助记词",
        "sourceHash": "dd2264b1e132960b"
      },
      "summary": {
        "text": "这 12 个助记词是你账户的密钥。它们为何重要、在哪里找到、如何安全保存，以及添加登录方式作为备用找回途径。",
        "sourceHash": "7033308ae096c586"
      }
    },
    "your-profile": {
      "title": {
        "text": "个人资料",
