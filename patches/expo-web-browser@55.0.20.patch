     // This prevents the Custom Tab from being destroyed when the main activity
     // has singleTask launch mode
     if (options.useProxyActivity) {
+      // BeanPool: a tab the member left with Home or the app switcher keeps the proxy's task (.webContainer) alive. As
+      // published, the next proxy intent equalled that task's root intent (the URL rode only in extras), so Android
+      // brought the old task back as it was left and dropped the new URL: "Manage" showed a stale, signed-out Settings
